<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ConstrurrentaMobile" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryTintLight</item>
        <item name="colorOnPrimaryContainer">@color/primaryColor</item>

        <!-- Colores Secundarios -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/primaryColor</item>
        <item name="colorSecondaryContainer">@color/secondaryTintLight</item>
        <item name="colorOnSecondaryContainer">@color/textColor</item>

        <!-- Superficies y Fondos -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/textColor</item>
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorOnBackground">@color/textColor</item>

        <!-- Variante de Superficie (para SurfaceVariant) -->
        <item name="colorSurfaceVariant">@color/backgroundColor</item>
        <item name="colorOnSurfaceVariant">@color/textMutedColor</item>

        <!-- Estados -->
        <item name="colorError">@color/errorColor</item>
        <item name="colorOnError">@color/white</item>

        <!-- Outline / Dividers -->
        <item name="colorOutline">@color/dividerColor</item>

        <!-- Tipografía -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.ConstrurrentaMobile" parent="Base.Theme.ConstrurrentaMobile" />
</resources>